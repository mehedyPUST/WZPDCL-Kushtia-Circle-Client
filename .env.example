# MongoDB (only needed if Next.js API routes talk to DB directly)
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/load-management

# External Express API (leave empty to use same-origin Next.js /api routes)
NEXT_PUBLIC_API_URL=http://localhost:5000

# JWT (must match backend if using Next.js auth routes)
JWT_SECRET=change-me-to-a-long-random-string

# Night-log AI generation (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional build id for PWA update detection
# NEXT_PUBLIC_APP_BUILD_ID=
