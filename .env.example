# MongoDB (required for production; omit for in-memory mock)
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/load-management

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=7d

# Groq API — used by Night Log "Generate With AI" (gsk_... key)
GROQ_API_KEY=
# Optional model override (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: use same-origin Next.js API only (leave empty)
# NEXT_PUBLIC_API_URL=
