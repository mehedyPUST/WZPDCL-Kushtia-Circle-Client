# Copy to .env.local and fill in real values. NEVER commit real secrets.
# MongoDB (required for production; omit for in-memory mock)
MONGODB_URI=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=7d

# Groq API — Night Logs "Generate With AI"
GROQ_API_KEY=

# Optional: leave empty to use same-origin Next.js /api routes
# NEXT_PUBLIC_API_URL=
